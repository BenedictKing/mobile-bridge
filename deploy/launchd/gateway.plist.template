<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mobile-bridge.gateway</string>
	<!-- 固定路径 + 稳定签名（make dev-cert / make install）：避免 TCC 因重编译
	     改变 ad-hoc 哈希而反复弹目录授权。 -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/mobile-bridge-gateway</string>
		<string>serve</string>
		<string>--data-dir</string>
		<string>@CURDIR@/.local</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@CURDIR@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- ACP agent 自动发现依赖 PATH 里的 npx/node（zcode/claude/dsh 的
		     npx 回退）；注入 fnm 稳定安装路径，launchd 无 shell 钩子。 -->
		<key>PATH</key>
		<string>@HOME@/.local/bin:@HOME@/.local/share/fnm/node-versions/v24.18.0/installation/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>GATEWAY_ACP_HOST_SOCKETS</key>
		<string>@ACP_HOST_SOCKETS@</string>
		<!-- ACP 账号池导入源：zcode-switcher 数据目录（含 accounts-kimi/ 等）。 -->
		<key>GATEWAY_ZCAS_DIR</key>
		<string>@HOME@/works/unsorted/zcode-switcher</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/mobile-bridge-gateway.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/mobile-bridge-gateway.log</string>
</dict>
</plist>
